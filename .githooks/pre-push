#!/bin/sh
# Release validation hook: runs only when pushing version tags (v*)
while read local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in
    refs/tags/v*) ;;
    *) continue ;;
  esac

  TAG=${local_ref#refs/tags/v}
  VERSION=$(bun -e "console.log(require('./package.json').version)")
  if [ "$TAG" != "$VERSION" ]; then
    echo "Error: Tag v$TAG does not match package.json version $VERSION" >&2
    exit 1
  fi

  MANIFEST=$(bun -e "console.log(require('./extension/manifest.json').version)")
  if [ "$MANIFEST" != "$VERSION" ]; then
    echo "Error: manifest.json version $MANIFEST does not match package.json version $VERSION" >&2
    exit 1
  fi

  if [ -n "$(git status --porcelain)" ]; then
    echo "Error: Working tree is not clean. Commit or stash all changes before tagging." >&2
    exit 1
  fi

  echo "Running pre-release tests and typecheck..."
  bun test || exit 1
  bun run typecheck || exit 1

  echo "Building release artifacts..."
  bun scripts/build.ts --all || exit 1

  echo "Verifying build sha256 checksums..."
  bun -e '
    const fs = require("node:fs");
    const crypto = require("node:crypto");
    const path = require("node:path");
    const latest = JSON.parse(fs.readFileSync("dist/latest.json", "utf8"));
    for (const [arch, info] of Object.entries(latest.binaries)) {
      const file = path.join("dist", info.url);
      const sum = crypto.createHash("sha256").update(fs.readFileSync(file)).digest("hex");
      if (sum !== info.sha256) throw new Error(`SHA256 mismatch for ${file}: expected ${info.sha256}, got ${sum}`);
    }
    const extFile = path.join("dist", latest.extension.url);
    const extSum = crypto.createHash("sha256").update(fs.readFileSync(extFile)).digest("hex");
    if (extSum !== latest.extension.sha256) throw new Error(`SHA256 mismatch for ${extFile}: expected ${latest.extension.sha256}, got ${extSum}`);
  ' || exit 1

  if command -v gh >/dev/null 2>&1; then
    if gh release view "v$TAG" >/dev/null 2>&1; then
      echo "Release v$TAG already exists on GitHub."
    else
      echo "Creating GitHub release v$TAG..."
      gh release create "v$TAG" dist/* --title "v$TAG" --generate-notes || exit 1
    fi
  fi
done

exit 0
