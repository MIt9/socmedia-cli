{
  "manifest_version": 3,
  "name": "Socmedia CLI Bridge",
  "version": "0.15.0",
  "key": "",
  "description": "Connects the local Socmedia CLI service to Chrome.",
  "background": { "service_worker": "background.js" },
  "permissions": ["alarms", "storage", "tabs", "tabGroups", "scripting", "debugger"],
  "host_permissions": ["https://*.instagram.com/*", "https://*.facebook.com/*", "https://*.fb.com/*", "https://*.youtube.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  }
}
